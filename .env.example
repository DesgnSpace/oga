# Copy to .env and fill locally. Never commit .env.

# Cloudflare R2 write access for the shared downloads bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-shared-bucket-name

# Public URL and key prefix for every Oga release object.
R2_PUBLIC_BASE_URL=https://downloads.desgn.space
R2_KEY_PREFIX=oga

# macOS release signing and notarization.
APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
APPLE_ID=apple-id@example.com
APPLE_PASSWORD=app-specific-password
APPLE_TEAM_ID=TEAMID
TAURI_PUBLIC_KEY=tauri-updater-public-key
TAURI_SIGNING_PRIVATE_KEY=tauri-updater-private-key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
